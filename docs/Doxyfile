# Reproducible documentation build for bignum-bit-test quality gates.
PROJECT_NAME           = bignum-bit-test
PROJECT_NUMBER         = 1.1.0
OUTPUT_DIRECTORY       = $(DOXY_OUTPUT)
CREATE_SUBDIRS         = NO
INPUT                  = include src benchmarks tests
FILE_PATTERNS          = *.h *.c *.asm
EXTENSION_MAPPING      = asm=C
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */dist/* */reports/*
EXTRACT_ALL            = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
QUIET                  = NO
ALIASES                += "thread_safety=Thread safety:"
ALIASES                += "complexity=Complexity:"
SORT_MEMBER_DOCS       = NO
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = $(PWD)
